# Copy this file to .env and fill in the values. NEVER commit .env to GitHub.

# Application Settings
APP_NAME=ProductAPI
APP_KEY=
# development locally, production on Render
APP_ENV=development

# Database Configuration (Aiven MySQL -> Console > your service > Connection information)
DB_DRIVER=mysql
DB_HOST=your-service-name-your-project.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=

# Aiven requires TLS. Paste the CONTENT of Aiven's "CA certificate" (ca.pem) into
# DB_SSL_CA_CERT (on Render use the dashboard; newlines may be written as \n),
# or set DB_SSL_CA to a file path such as ./ca.pem when working locally.
DB_SSL=true
DB_SSL_CA_CERT=
DB_SSL_CA=
# DB_SSL_VERIFY=false

# For API  (generate both with:  php lava jwt:generate)
JWT_SECRET=
REFRESH_TOKEN_KEY=
JWT_ISSUER=product-management-api
JWT_AUDIENCE=product-management-clients

# CORS: comma-separated exact origins, no trailing slashes. Add the deployed frontend URL on Render.
ALLOW_ORIGIN=http://localhost:5173,https://api-tester.marasigan.dev

# Enables /migrate, /rollback ... routes and the "php lava migration" command.
# Set to true only while running migrations; keep false on the public Render server.
MIGRATION_ENABLED=true
